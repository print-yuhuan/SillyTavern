# 统一文本为 LF，保证 Linux CI 上 gradlew 与脚本可执行
* text=auto eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# gradlew 必须是 LF（CI 在 Linux 上以 sh 执行）
gradlew text eol=lf

# 二进制文件，不做行尾转换
*.jar binary
*.so binary
*.so.sha256 binary
*.zip binary
*.png binary
*.webp binary
*.jpg binary
*.ico binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
